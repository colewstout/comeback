# Copy to .env for local development. Everything except DATABASE_URL is optional locally:
# without Twilio/Resend keys, messages are printed to the console instead of sent.
DATABASE_URL=postgres://comeback:comeback@localhost:5432/comeback
APP_URL=http://localhost:3000
PORT=3000
SESSION_SECRET=           # production: a random string, 32+ characters
CRON_SECRET=              # protects POST /jobs/tick and /jobs/weekly-report

# Texting (Twilio). Point the number's "A message comes in" webhook to $APP_URL/webhooks/twilio/sms
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=       # e.g. +18005550123 (a verified toll-free or registered 10DLC number)

# Email (Resend). EMAIL_FROM must be on a domain you've verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=               # e.g. hello@mail.yourdomain.com

# Billing (Stripe). Create one monthly Price per plan. Webhook endpoint: $APP_URL/webhooks/stripe
# Events: checkout.session.completed, customer.subscription.updated, customer.subscription.deleted
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_MULTI=

# Square (optional). Create an app at https://developer.squareup.com/apps.
# In its OAuth settings, set the Redirect URL to $APP_URL/integrations/square/callback.
# Use SQUARE_ENVIRONMENT=sandbox with the sandbox app id/secret while testing.
SQUARE_APP_ID=
SQUARE_APP_SECRET=
SQUARE_ENVIRONMENT=production
TOKEN_ENCRYPTION_KEY=     # optional: separate key for encrypting stored Square tokens

# Founder access: these emails see the Admin tab (website sign-ups, every business).
ADMIN_EMAILS=             # e.g. you@yourdomain.com

# The server sends due messages every 15 minutes by itself. Set to 0 if you call
# POST /jobs/tick from an outside scheduler instead.
RUN_SCHEDULER=
